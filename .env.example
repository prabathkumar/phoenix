# TestOps Mobile environment configuration
# Copy this to .env and fill in values for your environment, or export
# these directly in whatever process manager / container runtime you use.
# TestOps Mobile's own scripts do not auto-load .env (no dotenv dependency yet) —
# either `export $(grep -v '^#' .env | xargs)` before running, or source it
# from your process manager (systemd EnvironmentFile=, docker --env-file, etc).

# --- Platform selection ---------------------------------------------------

# Which platform run-session.js targets: "android" (default, the only
# platform proven against real hardware end to end so far) or "ios".
# Switches which engine/ session starter is used and which selector
# syntax/tap extension generation/pipeline.js emits.
TESTOPS_MOBILE_PLATFORM=android

# --- Required: the app under test (Android) -------------------------------

# Absolute path to the .apk TestOps Mobile should install and launch for a
# recording session. Required by engine/session.js (spawn path) and
# engine/embedded-session.js (embed path) — there is no default.
TESTOPS_MOBILE_STAGE0_APP_PATH=/absolute/path/to/your-app.apk

# --- Required: the app under test (iOS, only read when TESTOPS_MOBILE_PLATFORM=ios) --
# See engine/ios-session.js. Only relevant when targeting iOS.

# Absolute path to a built .app bundle (Simulator) or .ipa (real device).
TESTOPS_MOBILE_IOS_APP_PATH=/absolute/path/to/YourApp.app

# Must match a Simulator installed via Xcode on this machine —
# `xcrun simctl list devices` shows what's available.
TESTOPS_MOBILE_IOS_DEVICE_NAME=iPhone 15

# iOS version of that Simulator, e.g. "17.5". Leave unset to let Appium
# pick whichever version of that device name is installed, if only one is.
TESTOPS_MOBILE_IOS_PLATFORM_VERSION=

# --- Appium server connection (spawn path only) --------------------------
# Only read by engine/session.js, used by stage0-session.js and
# run-session.js. Not used by the embedded path (embedded-session.js),
# which talks to the driver in-process and never opens this connection.

# Host where a separately-running `appium` CLI server is listening.
TESTOPS_MOBILE_APPIUM_HOST=127.0.0.1

# Port for the same server. Appium's own default is 4723.
TESTOPS_MOBILE_APPIUM_PORT=4723

# --- Remote provider (BrowserStack App Automate, instead of a local Appium
#     server) -------------------------------------------------------------
# Read by engine/remote-provider.js, used by both session.js and
# ios-session.js. Leave TESTOPS_MOBILE_APPIUM_PROVIDER unset (or "local") to keep
# using TESTOPS_MOBILE_APPIUM_HOST/PORT above -- nothing below applies then. Set
# it to "browserstack" when there's no local emulator/Simulator to point
# at (e.g. TestOps running on a Linux VM, where the iOS Simulator can't
# run at all) and you already have BrowserStack App Automate. See
# docs/SETUP.md's "2b. Or: skip your own device host entirely and use
# BrowserStack" for the full walkthrough.

# TESTOPS_MOBILE_APPIUM_PROVIDER=browserstack

# Your BrowserStack username and an Automate access key (not your account
# password) -- both from your BrowserStack account settings page.
# TESTOPS_MOBILE_BROWSERSTACK_USER=
# TESTOPS_MOBILE_BROWSERSTACK_KEY=

# bs://<id> from running `node engine/browserstack-upload.js /path/to/app`
# once per app build -- BrowserStack has no concept of a local file path
# or a bundle id already installed on a device, so this replaces
# TESTOPS_MOBILE_STAGE0_APP_PATH/TESTOPS_MOBILE_IOS_APP_PATH/TESTOPS_MOBILE_IOS_BUNDLE_ID
# entirely when this provider is active.
# TESTOPS_MOBILE_BROWSERSTACK_APP_URL=

# Optional -- label the session in BrowserStack's dashboard.
# TESTOPS_MOBILE_BROWSERSTACK_PROJECT=TestOps Mobile
# TESTOPS_MOBILE_BROWSERSTACK_BUILD=testops-mobile-recording
# TESTOPS_MOBILE_BROWSERSTACK_SESSION_NAME=TestOps Mobile recording session

# Route this session through a BrowserStackLocal tunnel, for an
# app-under-test whose backend isn't reachable from the public internet
# (e.g. an internal-only API). Requires the BrowserStackLocal binary
# already running separately on a machine that CAN reach that backend --
# this flag only tells BrowserStack to use the tunnel, it doesn't start one.
# Download/run it from https://www.browserstack.com/local-testing/releases,
# e.g.: ./BrowserStackLocal --key <your Automate access key>
# TESTOPS_MOBILE_BROWSERSTACK_LOCAL=1

# Only needed if you're running more than one BrowserStackLocal tunnel at
# once (e.g. --local-identifier was passed when starting it) -- must match
# exactly.
# TESTOPS_MOBILE_BROWSERSTACK_LOCAL_IDENTIFIER=

# --- Service ports ---------------------------------------------------------

# Port live-view/server.js's WebSocket server listens on. Read by
# run-session.js (to start it) and by live-view/test-client.js and
# frontend/index.html (the public deploy defaults to ws://localhost:8090,
# see the frontend's ?port= override) to connect to it. Also the base
# port engine/session-pool.js allocates from for a second/third/etc.
# concurrent session (see TESTOPS_MOBILE_SESSION_POOL_SIZE below) -- each one
# gets this port plus a sequential offset, not the same fixed port.
TESTOPS_MOBILE_LIVE_VIEW_PORT=8090

# How many recording sessions engine/session-manager.js's SessionPool
# allows at once (frontend/upload-session.js's /api/sessions endpoint).
# Default 1 -- a second upload while one session is active gets a 409,
# same behavior as before this existed. Raise this only once you
# actually have that many independent device/emulator slots for Appium
# to target concurrently -- the pool tracks capacity, it does not create
# devices. See docs/STATUS.md's "Concurrent sessions" entry.
TESTOPS_MOBILE_SESSION_POOL_SIZE=1

# Port frontend/server.js serves the local recording UI on, when you run
# it instead of using the public GitHub Pages deploy.
TESTOPS_MOBILE_FRONTEND_PORT=8091

# --- Scripted test client (optional, live-view/test-client.js only) -------
# Only used when driving a session with the scripted stand-in tester
# instead of a real browser (e.g. in CI) — not needed for normal use.

# Comma-separated "x,y" pairs describing where to tap, in order, e.g.
# "200,400;300,600". Leave unset to use the client's built-in default.
TESTOPS_MOBILE_TAP_SEQUENCE=

# Milliseconds to wait after each tap before capturing the next
# screenshot/tree, letting the UI settle. Defaults to a few hundred ms
# if unset.
TESTOPS_MOBILE_TAP_SETTLE_MS=500

# --- Android SDK (host/container prerequisite, not read by TestOps Mobile code) --
# These are standard Android SDK env vars Appium's UiAutomator2 driver
# needs on PATH — set them the same way you would for any Appium setup.
# TestOps Mobile's own code does not read these directly.

ANDROID_HOME=/absolute/path/to/android-sdk
JAVA_HOME=/absolute/path/to/jdk

# --- LLM refinement layer (generation/llm.js, opt-in) ----------------------
# Refines inferTestName()/inferAssertions()'s rule-based output via a local
# Ollama instance. Only takes effect when refinement is turned on
# (TESTOPS_MOBILE_USE_LLM=1 for run-session.js, or generateScript(steps, { useLlm:
# true }) directly) — off by default, in which case these are unread and
# TestOps Mobile runs the v1 rule-based pipeline only. Any failure here (Ollama not
# running, timeout, bad response) falls back to the rule-based result, so
# these are safe to leave at their defaults even with useLlm on.

# Turn on the refinement layer for run-session.js. Unset/0 = rule-based only.
TESTOPS_MOBILE_USE_LLM=0

# Where your local Ollama instance is listening.
TESTOPS_MOBILE_OLLAMA_HOST=http://localhost:11434

# Which pulled Ollama model to use (must already be pulled: `ollama pull llama3`).
TESTOPS_MOBILE_OLLAMA_MODEL=llama3

# How long to wait for a refinement call before falling back.
TESTOPS_MOBILE_LLM_TIMEOUT_MS=8000
