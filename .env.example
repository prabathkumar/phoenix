# Phoenix environment configuration
# Copy this to .env and fill in values for your environment, or export
# these directly in whatever process manager / container runtime you use.
# Phoenix's own scripts do not auto-load .env (no dotenv dependency yet) —
# either `export $(grep -v '^#' .env | xargs)` before running, or source it
# from your process manager (systemd EnvironmentFile=, docker --env-file, etc).

# --- Required: the app under test ---------------------------------------

# Absolute path to the .apk Phoenix should install and launch for a
# recording session. Required by engine/session.js (spawn path) and
# engine/embedded-session.js (embed path) — there is no default.
PHOENIX_STAGE0_APP_PATH=/absolute/path/to/your-app.apk

# --- Appium server connection (spawn path only) --------------------------
# Only read by engine/session.js, used by stage0-session.js and
# run-session.js. Not used by the embedded path (embedded-session.js),
# which talks to the driver in-process and never opens this connection.

# Host where a separately-running `appium` CLI server is listening.
PHOENIX_APPIUM_HOST=127.0.0.1

# Port for the same server. Appium's own default is 4723.
PHOENIX_APPIUM_PORT=4723

# --- Service ports ---------------------------------------------------------

# Port live-view/server.js's WebSocket server listens on. Read by
# run-session.js (to start it) and by live-view/test-client.js and
# frontend/index.html (the public deploy defaults to ws://localhost:8090,
# see the frontend's ?port= override) to connect to it.
PHOENIX_LIVE_VIEW_PORT=8090

# Port frontend/server.js serves the local recording UI on, when you run
# it instead of using the public GitHub Pages deploy.
PHOENIX_FRONTEND_PORT=8091

# --- Scripted test client (optional, live-view/test-client.js only) -------
# Only used when driving a session with the scripted stand-in tester
# instead of a real browser (e.g. in CI) — not needed for normal use.

# Comma-separated "x,y" pairs describing where to tap, in order, e.g.
# "200,400;300,600". Leave unset to use the client's built-in default.
PHOENIX_TAP_SEQUENCE=

# Milliseconds to wait after each tap before capturing the next
# screenshot/tree, letting the UI settle. Defaults to a few hundred ms
# if unset.
PHOENIX_TAP_SETTLE_MS=500

# --- Android SDK (host/container prerequisite, not read by Phoenix code) --
# These are standard Android SDK env vars Appium's UiAutomator2 driver
# needs on PATH — set them the same way you would for any Appium setup.
# Phoenix's own code does not read these directly.

ANDROID_HOME=/absolute/path/to/android-sdk
JAVA_HOME=/absolute/path/to/jdk

# --- Planned: LLM refinement layer (not yet implemented) ------------------
# Reserved for the upcoming Ollama-backed refinement of generation/pipeline.js
# (better flow names, filtered assertions, smarter parameter naming), with
# the existing rule-based logic kept as the fallback on any failure/timeout.
# Uncomment and adjust once generation/llm.js lands — unset today, Phoenix
# runs rule-based generation only and ignores these.

# PHOENIX_OLLAMA_HOST=http://localhost:11434
# PHOENIX_OLLAMA_MODEL=llama3
# PHOENIX_LLM_TIMEOUT_MS=8000
