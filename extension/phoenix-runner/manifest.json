{
  "manifest_version": 3,
  "name": "Phoenix Runner",
  "description": "Lets Phoenix (TestOps) use this Chrome for live test sessions on intranet and VPN apps. Connects out to Phoenix; only opens addresses you allow.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Phoenix Runner", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
